# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# 8 Linux servers on VirtualBox: Fedora 39 x2, RHEL 9 x2, Ubuntu 18.04,
# Ubuntu 20.04, Kali Rolling x2.  Note: several of these distros are EOL;
# they are kept for compatibility testing.
#
# Memory per VM defaults to 2048 MB (8 VMs = 16 GB).  Override:
#   VM_MEMORY=4096 vagrant up            (Linux/macOS)
#   $env:VM_MEMORY=4096; vagrant up      (PowerShell)
# Bring up a subset:  vagrant up rhel9-1 kali-rolling1
#
# If `vagrant up` fails the first time:
#   1) Update Vagrant
#   2) vagrant plugin install vagrant-vbguest
#   3) vagrant up

Vagrant.require_version ">= 2.3.0"

SERVERS = [
  { name: "fedora-base1",    box: "fedora/39-cloud-base", version: "39.20231031.1" },
  { name: "fedora-base2",    box: "fedora/39-cloud-base", version: "39.20231031.1" },
  { name: "rhel9-1",         box: "generic/rhel9" },
  { name: "rhel9-2",         box: "generic/rhel9" },
  { name: "ubuntu-bionic64", box: "ubuntu/bionic64" },
  { name: "ubuntu-focal64",  box: "ubuntu/focal64" },
  { name: "kali-rolling1",   box: "kalilinux/rolling" },
  { name: "kali-rolling2",   box: "kalilinux/rolling" },
].freeze

Vagrant.configure("2") do |config|
  config.vm.provider "virtualbox" do |vb|
    vb.memory = (ENV["VM_MEMORY"] || 2048).to_i
  end

  SERVERS.each do |s|
    config.vm.define s[:name] do |node|
      node.vm.box = s[:box]
      node.vm.box_version = s[:version] if s[:version]
      node.vm.hostname = s[:name]
    end
  end
end
