# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# Four Windows Server VMs on VirtualBox (2 GB RAM, 1 vCPU each):
#   activedirectory 10.0.7.2   (intended: Active Directory)
#   dnsserver       10.0.7.3   (intended: DNS)
#   sqlserver       10.0.7.4   (intended: Microsoft SQL)
#   webserver       10.0.7.5   (intended: IIS)
#
# The server roles are NOT configured yet; these are base Windows Server boxes.
# Windows boxes are large and slow to boot, hence the long timeouts.

Vagrant.require_version ">= 2.3.0"

SERVERS = {
  "activedirectory" => "10.0.7.2",
  "dnsserver"       => "10.0.7.3",
  "sqlserver"       => "10.0.7.4",
  "webserver"       => "10.0.7.5",
}.freeze

Vagrant.configure("2") do |config|
  config.vm.box = "gusztavvargadr/windows-server"
  config.vm.communicator = "winrm"
  config.vm.boot_timeout = 900

  SERVERS.each do |name, ip|
    config.vm.define name do |node|
      node.vm.hostname = name
      node.vm.network "private_network", ip: ip
      node.vm.provider "virtualbox" do |vb|
        vb.memory = 2048
        vb.cpus = 1
      end
    end
  end
end
