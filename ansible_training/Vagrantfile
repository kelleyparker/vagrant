# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# Fedora 38 VMs (default 8, 2 GB RAM each) with Ansible and ansible-navigator
# installed.  Used for studying for the RHCE (EX294, RHEL 9).
# `dnf upgrade` is deliberately skipped to save deployment time.
#
# Overrides:  VM_COUNT=3 VM_MEMORY=1024 vagrant up
# Note: Fedora 38 is EOL; set BOX / BOX_VERSION to use a newer Fedora box.

Vagrant.require_version ">= 2.3.0"

VM_COUNT    = (ENV["VM_COUNT"] || 8).to_i
VM_MEMORY   = (ENV["VM_MEMORY"] || 2048).to_i
BOX         = ENV["BOX"] || "fedora/38-cloud-base"
BOX_VERSION = ENV["BOX"] ? ENV["BOX_VERSION"] : (ENV["BOX_VERSION"] || "38.20230413.1")

Vagrant.configure("2") do |config|
  (1..VM_COUNT).each do |i|
    config.vm.define "fedora#{i}" do |node|
      node.vm.box = BOX
      node.vm.box_version = BOX_VERSION if BOX_VERSION
      node.vm.hostname = "fedora#{i}"

      node.vm.provider "virtualbox" do |vb|
        vb.memory = VM_MEMORY
      end

      node.vm.provision "shell", inline: <<-SHELL
        set -e
        dnf install -y ansible ansible-navigator
      SHELL
    end
  end
end
