# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# Single Ubuntu 24.04 VM running MySQL Server.
# Host-only IP: 192.168.33.10  (change DB_IP if it clashes with another lab)
#
# MySQL listens on localhost only by default.  To allow remote clients, set
# bind-address in /etc/mysql/mysql.conf.d/mysqld.cnf and create a user for
# the host-only network.

Vagrant.require_version ">= 2.3.0"

DB_IP = ENV["DB_IP"] || "192.168.33.10"

Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"
  config.vm.hostname = "dbserver"
  config.vm.network "private_network", ip: DB_IP

  config.vm.provider "virtualbox" do |vb|
    vb.memory = 1024
    vb.cpus = 1
  end

  config.vm.provision "shell", inline: <<-SHELL
    set -e
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -y
    apt-get install -y mysql-server
    systemctl enable --now mysql
  SHELL
end
