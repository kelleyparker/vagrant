# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# LAMP server (Apache, MySQL, PHP) on Ubuntu 24.04 with a small demo form.
# Host-only IP 192.168.56.20  ->  http://192.168.56.20/
# Submitted names are stored in db1.users.
#
# The DB password below is for this throwaway lab only.  Override it with
#   DB_PASSWORD=something vagrant up

Vagrant.require_version ">= 2.3.0"

DB_USER     = "labuser"
DB_PASSWORD = ENV["DB_PASSWORD"] || "password"
LAMP_IP     = ENV["LAMP_IP"] || "192.168.56.20"

Vagrant.configure("2") do |config|
  config.vm.define "LampServer" do |lamp|
    lamp.vm.box = "bento/ubuntu-24.04"
    lamp.vm.hostname = "lampserver"
    lamp.vm.network "private_network", ip: LAMP_IP

    lamp.vm.provider "virtualbox" do |vb|
      vb.memory = 2048
      vb.cpus = 2
      vb.gui = false
    end

    lamp.vm.boot_timeout = 900 # 15 minutes (default is 300 seconds)

    lamp.vm.provision "shell",
      env: { "DB_USER" => DB_USER, "DB_PASSWORD" => DB_PASSWORD },
      inline: <<-SHELL
        set -e
        export DEBIAN_FRONTEND=noninteractive
        apt-get update -y
        apt-get upgrade -y
        apt-get install -y apache2 mysql-server php libapache2-mod-php php-mysql

        # Database, user and table (idempotent)
        mysql -e "CREATE DATABASE IF NOT EXISTS db1;"
        mysql -e "CREATE USER IF NOT EXISTS '${DB_USER}'@'localhost' IDENTIFIED BY '${DB_PASSWORD}';"
        mysql -e "GRANT SELECT, INSERT ON db1.* TO '${DB_USER}'@'localhost'; FLUSH PRIVILEGES;"
        mysql db1 < /vagrant/create_table.sql

        # App credentials live outside the web root, readable only by Apache
        install -m 640 -o root -g www-data /dev/null /etc/lamp_db.ini
        printf 'user=%s\npassword=%s\ndbname=db1\n' "$DB_USER" "$DB_PASSWORD" > /etc/lamp_db.ini

        install -m 644 /vagrant/index.html /var/www/html/index.html
        install -m 644 /vagrant/process.php /var/www/html/process.php
        systemctl restart apache2
      SHELL
  end
end
